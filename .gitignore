# pixi environments
.pixi/*
!.pixi/config.toml
.pixi/
.venv/

# asen_results pipeline outputs (4+ GB, regenerate with `pixi run ...` inside asen_results/)
/asen_results/data/

# AquaGuard outputs and data policy
data/raw/*
!data/raw/manifest.json
!data/raw/nisar/
!data/raw/nisar/**
data/interim/
data/static/scripts/
.playwright-mcp/
outputs/scratch/

__pycache__/
.pytest_cache/
*.pyc

# Coryell data: rebuilt by scripts/fetch_coryell_data.py (see viz/README.md)
/data/coryell/*
!/data/coryell/README.md
